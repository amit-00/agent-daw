{
  "name": "agent-daw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "unrs-resolver"]
  },
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "test": "pnpm run test:project && pnpm run test:ui",
    "test:project": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "test:ui": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.project.json"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^3.2.7"
  }
}
